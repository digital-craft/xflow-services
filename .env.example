ENV=dev

COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROJECT_NAME=xflow

# PostgreSQL
POSTGRES_DB=xflow
POSTGRES_USER=xflow
POSTGRES_PASSWORD=xflow
POSTGRES_PORT=5432
POSTGRES_PORT_EXT=5433

# Redis
REDIS_PORT=6379

# Docs
DOCS_PORT=5000

# Martin Service
MARTIN_PORT=3000

# API Gateway
API_GATEWAY_PORT=8080

# Map Service
MAP_SERVICE_PORT=8082
STORAGE_TYPE=
LOCAL_STORAGE_PATH=

# Auth Service
AUTH_SERVICE_PORT=8081
EXPIRATION_MS=900000
REFRESH_EXPIRATION_MS=8640000000
AUTH_MAX_FAILED_ATTEMPTS=3
AUTH_LOCKOUT_DURATION_MS=1800000
AUTH_ANON_MAX_ATTEMPTS=5
AUTH_ANON_LOCKOUT_DURATION_MS=3600000

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_UI_PORT=8025

# AWS S3
AWS_S3_BUCKET_NAME=
AWS_REGION=