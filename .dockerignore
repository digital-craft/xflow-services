# Root Docker ignore file for XFlow Monorepo
# =============================================================================

# Build artifacts
**/target/
**/node_modules/
**/dist/
**/build/

# IDEs
.idea/
.vscode/
*.iml
*.swp

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Environment / Secrets
.env
.env.*
! .env.example
*.pem
*.key

# Logs
*.log
logs/

# Documentation
docs/backstage/node_modules/
docs/backstage/dist/
