ENV=dev

COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# API Gateway
API_GATEWAY_PORT=8080

# Auth Service
AUTH_SERVICE_PORT=8081

# Map Service
MAP_SERVICE_PORT=8082

# PostgreSQL
POSTGRES_DB=xflow-dev
POSTGRES_USER=xflow
POSTGRES_PASSWORD=xflow
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_UI_PORT=8025

# AWS S3
AWS_S3_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

#Martin
MARTIN_PORT=3000
